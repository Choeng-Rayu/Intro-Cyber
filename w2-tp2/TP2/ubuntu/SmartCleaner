#!/bin/bash

# SmartCleaner - One-click installer and service
# Just like a .exe file for Windows!

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PYTHON_SCRIPT="$SCRIPT_DIR/deleteFolderUbuntu.py"
SERVICE_NAME="smart-cleaner"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║   Smart Cleaner - Auto Setup          ║${NC}"
echo -e "${BLUE}║   Click once, runs forever!           ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

# Check if Python script exists
if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo -e "${RED}❌ Error: deleteFolderUbuntu.py not found in $SCRIPT_DIR${NC}"
    exit 1
fi

# Get current user
CURRENT_USER="$USER"

echo "📋 Setting up Smart Cleaner Service..."
echo "   User: $CURRENT_USER"
echo "   Location: $SCRIPT_DIR"
echo ""

# Create service file dynamically
echo "🔧 Creating service file..."
sudo tee /etc/systemd/system/smart-cleaner.service > /dev/null <<EOF
[Unit]
Description=Smart Cleaner - Automatic Background Cleanup Service
After=network.target

[Service]
Type=simple
User=$CURRENT_USER
WorkingDirectory=$SCRIPT_DIR
ExecStart=/usr/bin/python3 $PYTHON_SCRIPT
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-cleaner

[Install]
WantedBy=multi-user.target
EOF

if [ $? -eq 0 ]; then
    echo -e "${GREEN}✅ Service file created${NC}"
else
    echo -e "${RED}❌ Failed to create service file${NC}"
    exit 1
fi

# Make Python script executable
chmod +x "$PYTHON_SCRIPT"

# Reload systemd daemon
echo "🔄 Reloading systemd daemon..."
sudo systemctl daemon-reload

# Enable service (auto-start on boot)
echo "📌 Enabling auto-start on boot..."
sudo systemctl enable $SERVICE_NAME.service > /dev/null 2>&1

# Start the service
echo "🚀 Starting service..."
sudo systemctl start $SERVICE_NAME.service

if [ $? -eq 0 ]; then
    echo ""
    echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   ✅ SUCCESS - Service is Running!     ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
    echo ""
    echo "📊 Service Status:"
    sudo systemctl status $SERVICE_NAME.service --no-pager
    echo ""
    echo -e "${BLUE}📋 Useful Commands:${NC}"
    echo "   View logs:       sudo journalctl -u $SERVICE_NAME -f"
    echo "   Stop service:    sudo systemctl stop $SERVICE_NAME"
    echo "   Restart:         sudo systemctl restart $SERVICE_NAME"
    echo "   Disable at boot: sudo systemctl disable $SERVICE_NAME"
    echo ""
    echo -e "${GREEN}Your service is now running in the background forever!${NC}"
else
    echo -e "${RED}❌ Failed to start service${NC}"
    exit 1
fi

# Keep terminal open if launched from GUI
read -p "Press Enter to close..."
