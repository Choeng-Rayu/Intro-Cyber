@startuml Parallel_Brute_Force_Flow

title Parallel Brute Force Attack - Detailed Flow

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10

|Main Thread|
start

:Initialize Parallel\nBrute Force Attack;

:startTime = now();
:resultChan = make(chan);

note right
    Configuration:
    • NumWorkers = 4
    • MaxLength = 5
    • CharacterSet = "A-Za-z0-9"
end note

partition "For each password length (1 to MaxLength)" {
    
    :passwordLength = 1;
    
    repeat
        
        :Calculate total combinations\nfor this length;
        note right
            Total = CharsetSize ^ Length
            Example: 62^5 = 916,132,832
        end note
        
        :Calculate chunkSize\nper worker;
        note right
            chunkSize = Total / NumWorkers
            Example: 916M / 4 = 229M each
        end note
        
        fork
            |Worker 1|
            :startRange = 0;
            :endRange = chunkSize;
            :Search range 0-25%;
            
            repeat
                :Generate combination\nfrom number;
                :attempts++;
                
                if (combination == target?) then (yes)
                    #palegreen:✓ Found!;
                    :Send result to\nresultChan;
                    kill
                endif
                
            repeat while (n < endRange?) is (yes)
            ->no;
            :Worker 1 Done;
            
        fork again
            |Worker 2|
            :startRange = chunkSize;
            :endRange = 2 * chunkSize;
            :Search range 25-50%;
            
            repeat
                :Generate combination\nfrom number;
                :attempts++;
                
                if (combination == target?) then (yes)
                    #palegreen:✓ Found!;
                    :Send result to\nresultChan;
                    kill
                endif
                
            repeat while (n < endRange?) is (yes)
            ->no;
            :Worker 2 Done;
            
        fork again
            |Worker 3|
            :startRange = 2 * chunkSize;
            :endRange = 3 * chunkSize;
            :Search range 50-75%;
            
            repeat
                :Generate combination\nfrom number;
                :attempts++;
                
                if (combination == target?) then (yes)
                    #palegreen:✓ Found!;
                    :Send result to\nresultChan;
                    kill
                endif
                
            repeat while (n < endRange?) is (yes)
            ->no;
            :Worker 3 Done;
            
        fork again
            |Worker 4|
            :startRange = 3 * chunkSize;
            :endRange = totalCombinations;
            :Search range 75-100%;
            
            repeat
                :Generate combination\nfrom number;
                :attempts++;
                
                if (combination == target?) then (yes)
                    #palegreen:✓ Found!;
                    :Send result to\nresultChan;
                    kill
                endif
                
            repeat while (n < endRange?) is (yes)
            ->no;
            :Worker 4 Done;
            
        end fork
        
        |Main Thread|
        :Wait for all workers\nto complete;
        
        :Check resultChan\nfor success;
        
        if (Result received?) then (yes)
            #palegreen:Password Found! ✓;
            
            :result.TimeTaken = now() - startTime;
            :result.Method = "Parallel Brute Force";
            
            if (Verbose?) then (yes)
                :Print success message;
                :Print which worker found it;
                :Print password;
                :Print time taken;
            endif
            
            stop
            
        else (no)
            :Continue to next length;
        endif
        
        :passwordLength++;
        
    repeat while (passwordLength <= MaxLength?) is (yes)
    ->no;
}

#pink:Not found\n(MaxLength too small);

:Create result:\n• Found = false\n• TimeTaken = now() - startTime\n• Method = "Parallel Brute Force";

stop

@enduml
