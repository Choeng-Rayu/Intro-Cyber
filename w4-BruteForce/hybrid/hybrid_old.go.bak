package main

import (
	"fmt"
	"sync"
	"time"
)

// ============================================================================
// MULTI-THREADED BRUTE FORCE PASSWORD CRACKER
// ============================================================================

// AttackResult stores the result of our password cracking attempt
type AttackResult struct {
	Password  string        // The password we found
	Found     bool          // Did we find it?
	Attempts  int64         // How many tries did it take?
	TimeTaken time.Duration // How long did it take?
	WorkerID  int           // Which worker found it (for parallel attacks)
}

// Config holds all settings for the attack
type Config struct {
	TargetPassword string // The password we're trying to crack
	CharacterSet   string // All possible characters (A-Z, a-z, 0-9)
	MaxLength      int    // Maximum password length to try
	NumWorkers     int    // How many parallel workers to use
	Verbose        bool   // Print progress messages?
}


// ============================================================================
// PARALLEL BRUTE FORCE ATTACK
// ============================================================================

func ParallelBruteForceAttack(config Config) AttackResult {

// ============================================================================
// STEP 2: BRUTE FORCE ATTACK (Try every possible combination)
// ============================================================================
// This is like trying every possible key for a lock.
//
// How it works:
// 1. Start with 1-character passwords: A, B, C, ... 9
// 2. Then 2-character: AA, AB, AC, ... 99
// 3. Then 3-character: AAA, AAB, ... 999
// ... and so on until we find it!
//
// This WILL find any password, but it can be VERY slow!
// ============================================================================

func BruteForceAttack(config HybridConfig) AttackResult {
	startTime := time.Now()
	totalAttempts := int64(0)

	if config.Verbose {
		fmt.Println("\n[STEP 2] Starting Brute Force Attack...")
		fmt.Println("This may take a while...")
	}

	// Try passwords of increasing length: 1, 2, 3, 4, 5...
	for passwordLength := 1; passwordLength <= config.MaxLength; passwordLength++ {
		if config.Verbose {
			fmt.Printf("\n  Trying all %d-character passwords...\n", passwordLength)
		}

		// Try all combinations of this length
		found, password, attempts := tryAllCombinations(
			config.TargetPassword,
			config.CharacterSet,
			passwordLength,
			config.Verbose,
		)

		totalAttempts += int64(attempts)

		// Did we find it?
		if found {
			result := AttackResult{
				Password:  password,
				Found:     true,
				Attempts:  totalAttempts,
				TimeTaken: time.Since(startTime),
				Method:    "Brute Force Attack",
			}

			if config.Verbose {
				fmt.Printf("\n  ✓ FOUND! Password is: %s\n", password)
				fmt.Printf("  Total attempts: %d\n", result.Attempts)
				fmt.Printf("  Time: %.6f seconds\n", result.TimeTaken.Seconds())
			}

			return result
		}
	}

	// Not found (shouldn't happen if MaxLength is large enough)
	return AttackResult{
		Found:     false,
		Attempts:  totalAttempts,
		TimeTaken: time.Since(startTime),
		Method:    "Brute Force Attack",
	}
}

// ============================================================================
// HELPER FUNCTION: Try all combinations of a specific length
// ============================================================================
// This generates every possible password of a given length.
//
// Example for length=2 with charset="ABC":
// AA, AB, AC, BA, BB, BC, CA, CB, CC
// ============================================================================

func tryAllCombinations(target, charset string, length int, verbose bool) (bool, string, int) {
	attempts := 0
	indices := make([]int, length) // Tracks position in charset for each character

	// How many combinations will we try?
	totalCombinations := 1
	for i := 0; i < length; i++ {
		totalCombinations *= len(charset)
	}

	// Try all combinations
	for {
		// Build the current password from indices
		candidate := ""
		for _, index := range indices {
			candidate += string(charset[index])
		}

		attempts++

		// Show progress every 10 million attempts
		if verbose && attempts > 0 && attempts%10000000 == 0 {
			progress := float64(attempts) / float64(totalCombinations) * 100
			fmt.Printf("    Progress: %d/%d (%.2f%%)\n", attempts, totalCombinations, progress)
		}

		// Check if this is the password we're looking for
		if candidate == target {
			return true, candidate, attempts
		}

		// Increment indices (like counting in a different base)
		// This is like a car's odometer: 000 -> 001 -> 002 -> ... -> 999
		carry := 1
		for i := length - 1; i >= 0 && carry > 0; i-- {
			indices[i] += carry
			if indices[i] >= len(charset) {
				indices[i] = 0 // Reset and carry to next position
			} else {
				carry = 0 // No more carrying needed
			}
		}

		// If carry is still 1, we've tried all combinations
		if carry > 0 {
			break
		}
	}

	return false, "", attempts
}

// ============================================================================
// STEP 3: PARALLEL BRUTE FORCE (Use multiple CPU cores)
// ============================================================================
// Instead of one worker trying all combinations, we split the work:
// - Worker 1: tries combinations 0 to 25%
// - Worker 2: tries combinations 25% to 50%
// - Worker 3: tries combinations 50% to 75%
// - Worker 4: tries combinations 75% to 100%
//
// This makes it MUCH faster on multi-core CPUs!
// ============================================================================

func ParallelBruteForceAttack(config HybridConfig) AttackResult {
	startTime := time.Now()
	resultChan := make(chan AttackResult, 1) // Channel to receive results
	var wg sync.WaitGroup

	if config.Verbose {
		fmt.Println("\n[STEP 2 - PARALLEL] Starting Parallel Brute Force Attack...")
		fmt.Printf("Using %d workers...\n", config.NumWorkers)
	}

	// Try each password length
	for passwordLength := 1; passwordLength <= config.MaxLength; passwordLength++ {
		if config.Verbose {
			fmt.Printf("\n  Trying all %d-character passwords with %d workers...\n",
				passwordLength, config.NumWorkers)
		}

		// Calculate how many combinations exist for this length
		totalCombinations := int64(1)
		for i := 0; i < passwordLength; i++ {
			totalCombinations *= int64(len(config.CharacterSet))
		}

		// Divide work among workers
		chunkSize := (totalCombinations + int64(config.NumWorkers) - 1) / int64(config.NumWorkers)

		// Launch workers
		for workerID := 0; workerID < config.NumWorkers; workerID++ {
			wg.Add(1)

			startRange := int64(workerID) * chunkSize
			endRange := int64(workerID+1) * chunkSize
			if endRange > totalCombinations {
				endRange = totalCombinations
			}

			// Start a worker in parallel
			go bruteForceWorker(
				config,
				passwordLength,
				startRange,
				endRange,
				workerID,
				resultChan,
				&wg,
			)
		}

		// Wait for all workers to finish
		wg.Wait()

		// Check if any worker found the password
		select {
		case result := <-resultChan:
			result.TimeTaken = time.Since(startTime)
			result.Method = "Parallel Brute Force Attack"

			if config.Verbose {
				fmt.Printf("\n  ✓ FOUND by Worker #%d! Password is: %s\n",
					result.WorkerID, result.Password)
				fmt.Printf("  Total time: %.6f seconds\n", result.TimeTaken.Seconds())
			}

			return result
		default:
			// Not found yet, continue to next length
		}
	}

	// Not found
	return AttackResult{
		Found:     false,
		TimeTaken: time.Since(startTime),
		Method:    "Parallel Brute Force Attack",
	}
}

// Worker function for parallel brute force
func bruteForceWorker(
	config HybridConfig,
	length int,
	start, end int64,
	workerID int,
	resultChan chan AttackResult,
	wg *sync.WaitGroup,
) {
	defer wg.Done()

	attempts := int64(0)

	// Try combinations in our assigned range
	for n := start; n < end; n++ {
		// Convert number to password string
		candidate := numberToPassword(config.CharacterSet, n, length)
		attempts++

		// Show progress for this worker
		if config.Verbose && attempts > 0 && attempts%5000000 == 0 {
			fmt.Printf("    Worker #%d: %d attempts\n", workerID, attempts)
		}

		// Check if this is the password
		if candidate == config.TargetPassword {
			// Found it! Send result
			resultChan <- AttackResult{
				Password: candidate,
				Found:    true,
				Attempts: attempts,
				WorkerID: workerID,
			}
			return
		}
	}
}

// Helper: Convert a number to a password string
func numberToPassword(charset string, num int64, length int) string {
	if num == 0 && length == 1 {
		return string(charset[0])
	}

	result := ""
	base := int64(len(charset))

	// Convert number to base-N (where N = charset length)
	for i := 0; i < length; i++ {
		result = string(charset[num%base]) + result
		num /= base
	}

	// Pad with first character if needed
	for len(result) < length {
		result = string(charset[0]) + result
	}

	return result[:length]
}

// ============================================================================
// THE HYBRID ATTACK: Combining Dictionary + Brute Force
// ============================================================================
// This is the BEST strategy because:
// 1. If the password is common, dictionary finds it INSTANTLY
// 2. If the password is strong, brute force WILL find it (eventually)
//
// It's like being prepared for both easy and hard scenarios!
// ============================================================================

func HybridAttack(config HybridConfig) AttackResult {
	totalStartTime := time.Now()

	if config.Verbose {
		fmt.Println("=" + string(make([]byte, 70)))
		fmt.Println("HYBRID ATTACK - COMBINATION OF DICTIONARY + BRUTE FORCE")
		fmt.Println("=" + string(make([]byte, 70)))
		fmt.Printf("\nTarget Password: %s\n", config.TargetPassword)
		fmt.Printf("Dictionary Size: %d passwords\n", len(config.Dictionary))
		fmt.Printf("Max Length: %d characters\n", config.MaxLength)
		fmt.Printf("Workers: %d\n", config.NumWorkers)
	}

	// PHASE 1: Try Dictionary Attack first (fast!)
	dictResult := DictionaryAttack(config)

	if dictResult.Found {
		// Success! Found it in the dictionary!
		dictResult.TimeTaken = time.Since(totalStartTime)

		if config.Verbose {
			fmt.Println("\n" + "=" + string(make([]byte, 70)))
			fmt.Println("SUCCESS! Password found using Dictionary Attack!")
			fmt.Println("=" + string(make([]byte, 70)))
			fmt.Printf("Password: %s\n", dictResult.Password)
			fmt.Printf("Attempts: %d\n", dictResult.Attempts)
			fmt.Printf("Time: %.6f seconds\n", dictResult.TimeTaken.Seconds())
		}

		return dictResult
	}

	// PHASE 2: Dictionary failed, try Brute Force (slow but thorough)
	if config.Verbose {
		fmt.Println("\n" + "-" + string(make([]byte, 70)))
		fmt.Println("Dictionary attack failed. Moving to Brute Force...")
		fmt.Println("-" + string(make([]byte, 70)))
	}

	// Use parallel brute force for better performance
	bruteResult := ParallelBruteForceAttack(config)

	// Add dictionary attempts to total
	bruteResult.Attempts += dictResult.Attempts
	bruteResult.TimeTaken = time.Since(totalStartTime)

	if bruteResult.Found {
		if config.Verbose {
			fmt.Println("\n" + "=" + string(make([]byte, 70)))
			fmt.Println("SUCCESS! Password found using Brute Force!")
			fmt.Println("=" + string(make([]byte, 70)))
			fmt.Printf("Password: %s\n", bruteResult.Password)
			fmt.Printf("Total Attempts: %d (including %d dictionary attempts)\n",
				bruteResult.Attempts, dictResult.Attempts)
			fmt.Printf("Total Time: %.6f seconds\n", bruteResult.TimeTaken.Seconds())
		}

		return bruteResult
	}

	// Not found (shouldn't happen if config is correct)
	return AttackResult{
		Found:     false,
		Attempts:  dictResult.Attempts + bruteResult.Attempts,
		TimeTaken: time.Since(totalStartTime),
		Method:    "Hybrid Attack (Dictionary + Brute Force)",
	}
}

// ============================================================================
// MAIN FUNCTION - EXAMPLE USAGE
// ============================================================================

func main() {
	// ============================================================================
	// MULTI-THREADED BRUTE FORCE - 5 CHARACTER PASSWORD
	// ============================================================================
	targetPassword := "Za8yK"

	// Validate password length
	if len(targetPassword) != 5 {
		fmt.Printf("❌ ERROR: Password must be exactly 5 characters!\n")
		return
	}

	// Character set (A-Z, a-z, 0-9)
	charset := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

	// Calculate search space: 62^5 = 916,132,832
	totalCombinations := int64(1)
	for i := 0; i < 5; i++ {
		totalCombinations *= int64(len(charset))
	}

	// Use more workers for maximum speed (8-16 workers recommended)
	numWorkers := 16 // Increase to 16 workers for maximum multi-core performance

	// Configuration
	config := HybridConfig{
		TargetPassword: targetPassword,
		Dictionary:     []string{}, // No dictionary - pure brute force
		CharacterSet:   charset,
		MaxLength:      5,
		NumWorkers:     numWorkers,
		Verbose:        true,
	}

	// Display configuration
	fmt.Println("🚀 MULTI-THREADED BRUTE FORCE ATTACK")
	fmt.Println("=" + string(make([]byte, 50)))
	fmt.Printf("Target:          %s\n", targetPassword)
	fmt.Printf("Search Space:    %d combinations\n", totalCombinations)
	fmt.Printf("Workers:         %d parallel threads\n", numWorkers)
	fmt.Printf("Character Set:   %d chars (A-Z, a-z, 0-9)\n", len(charset))
	fmt.Println("=" + string(make([]byte, 50)))
	fmt.Println()

	// Run multi-threaded brute force attack
	result := ParallelBruteForceAttack(config)

	// Print results
	fmt.Println("\n" + "=" + string(make([]byte, 50)))
	fmt.Println("RESULTS")
	fmt.Println("=" + string(make([]byte, 50)))

	if result.Found {
		fmt.Printf("✓ SUCCESS!\n")
		fmt.Printf("Password Found:  %s\n", result.Password)
		fmt.Printf("Worker ID:       #%d\n", result.WorkerID)
		fmt.Printf("Attempts:        %d\n", result.Attempts)
		fmt.Printf("Time Taken:      %.3f seconds\n", result.TimeTaken.Seconds())
		fmt.Printf("Speed:           %.0f attempts/second\n",
			float64(result.Attempts)/result.TimeTaken.Seconds())
	} else {
		fmt.Printf("✗ Password not found\n")
		fmt.Printf("Attempts: %d\n", result.Attempts)
		fmt.Printf("Time: %.3f seconds\n", result.TimeTaken.Seconds())
	}

	fmt.Println("=" + string(make([]byte, 50)))
	fmt.Println()
	fmt.Printf("💡 Multi-threading speedup: ~%dx faster than single thread\n", numWorkers/2)
	fmt.Println("💡 More CPU cores = faster password cracking")
	fmt.Println("💡 5-character passwords take minutes to crack")
	fmt.Println("🔐 Use 12+ characters for strong security!")
}
